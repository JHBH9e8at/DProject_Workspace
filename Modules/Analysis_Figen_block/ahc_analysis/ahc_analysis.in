# Run: python run_ahc_analysis.py --config ahc_analysis.in

# Required paths and shared run identifier
pr_input=/home/andy/proj/work_results/AHC_Resultsbin/SMILES-RNN_PRrun/scores.csv
pps_input=/home/andy/proj/work_results/AHC_Resultsbin/SMILES-RNN_PPSrun/scores.csv
results_root=/home/andy/proj/work_results
run_id=PR_PPS_completed

# Analysis blocks: ON/OFF
physchem=ON
last_window=ON
scaffold=OFF
chemical_space=OFF

# Common options
reference=/home/andy/proj/DProject_Workspace/AHC_Related/ref_structures/ref_desc.csv
last_n=50
resume=OFF

# Chemical-space options
usecache=ON
methods=umap,tsne
features=fp,all_desc,select_desc
random_state=42

# scaffold=ON obtains its UMAP/fingerprint membership automatically.
# See README.md for cache and option override rules.
