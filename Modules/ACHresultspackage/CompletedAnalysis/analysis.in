# Run: python run_analysis.py --config analysis.in

# Required
pr_input=/home/andy/proj/work_results/AHC_Resultsbin/SMILES-RNN_PRrun/scores.csv
pps_input=/home/andy/proj/work_results/AHC_Resultsbin/SMILES-RNN_PPSrun/scores.csv
results_root=/home/andy/proj/work_results
run_id=PR_PPS_completed

# Blocks: on/off
physchem=on
last_window=on
scaffold=on
chemical_space=on

# Common options
reference=/home/andy/proj/DProject_Workspace/AHC_Related/ref_structures/ref_desc.csv
last_n=50
# resume: on/off (default off)
resume=off

# Chemical-space options
# usecache: on/off (default on)
usecache=on
methods=umap,tsne
features=fp,all_desc,select_desc
random_state=42

# Allowed: methods=umap,tsne | features=fp,all_desc,select_desc
# scaffold=on prepares/reuses its required UMAP/fp membership automatically.
# See analysis.md for detailed behavior and defaults.
