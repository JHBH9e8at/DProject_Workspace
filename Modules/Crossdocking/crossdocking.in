# Cross-docking calculation
pps_input=/home/andy/proj/work_results/AHC_Resultsbin/SMILES-RNN_PPSrun/scores.csv
pps_run_dir=/home/andy/proj/work_results/AHC_Resultsbin/SMILES-RNN_PPSrun
pr_input=/home/andy/proj/work_results/AHC_Resultsbin/SMILES-RNN_PRrun/scores.csv
pr_run_dir=/home/andy/proj/work_results/AHC_Resultsbin/SMILES-RNN_PRrun
pps_grid=/home/andy/proj/DProject_Workspace/AHC_Related/ref_structures/grids/PPS/PPSgrid.zip
pr_grid=/home/andy/proj/DProject_Workspace/AHC_Related/ref_structures/grids/PR/PR_Auto_Grid.zip
output_dir=/home/andy/proj/work_results/crossdocking
results_root=/home/andy/proj/work_results
run_id=CDres_LP_ON

# Selection and docking
best_dscore_top_per=1
testmode_top_n=
precision=SP
ligand_prep_mode=on
allow_unavailable=off
resume=off
fail_fast=on

# Completed analysis
score_analysis=on
interaction_analysis=on
reference_interaction_analysis=on
pps_receptor=/home/andy/proj/DProject_Workspace/AHC_Related/ref_structures/Structures/PPS_Protein_no_conect.pdb
pr_receptor=/home/andy/proj/DProject_Workspace/AHC_Related/ref_structures/Structures/PR_Protein_no_conect.pdb
pps_reference_ligand=/home/andy/proj/DProject_Workspace/AHC_Related/ref_structures/Structures/PPS_ligand.sdfgz
pr_reference_ligand=/home/andy/proj/DProject_Workspace/AHC_Related/ref_structures/Structures/PR_ligand.sdfgz
interaction_mode=both
include_secondary_interactions=off
selectivity_threshold=2.0
strong_score_threshold=-8.0

# Multiprocessing applies only to completed interaction analysis.
# Glide cross-docking itself always runs sequentially.
multiprocessing=on
posecheck_workers=30
posecheck_chunk_size=auto
prolif_workers=30
