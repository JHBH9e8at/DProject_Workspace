# Cross-docking density figure configuration

# Root directory containing crossdocking/ and analysis/selectivity/.
results_dir=Q:\coding_dir\701_Project\Resultsbin\CDRes_LP_On

# Figure output directory. Relative paths are resolved from this .in file.
output_dir=Q:\coding_dir\701_Project\Writeup_Figures\Crossdocking

# own-state: molecule-level PPS->PPS and PR->PR best scores
# best: molecule-level cross-docked best scores
# double-arm: all cross-docked variants and poses
input_mode=own-state

# Colour coding inherited from the previous Fig_gen scripts.
PPS_color=#D9534F
PR_color=#2878B5
opposite_color=#9A9A9A

# Figure appearance
figure_width=7.2
figure_height=4.8
# Used by the three-panel own-state layout.
composite_figure_width=15
composite_figure_height=8.0
# Horizontal gap between the two lower panels; smaller values bring them closer.
panel_wspace=0
# Vertical gap between the upper and lower rows.
panel_hspace=0.12
bottom_legend_loc=upper right
bottom_left_legend_loc=upper right
bottom_right_legend_loc=upper right
legend_font_size=9

# Shared title spanning the two lower panels.
bottom_group_title=Own vs opposite receptor-state docking-score distributions
bottom_group_title_font_size=12
# Vertical gap above the individual PPS/PR panel titles (figure-coordinate units).
bottom_group_title_pad=0.04
dpi=600
fill_alpha=0.22
line_width=1
show_median=on
show_median_label=on
median_label_x_offset=8
median_label_y_offset=22

# Median-label offsets used only by the two lower panels.
bottom_median_label_x_offset=8
bottom_median_label_y_offset=22

# Independent lower-left (PPS ligands) offsets.
bottom_left_median_label_x_offset=8
bottom_left_median_label_y_offset=22
# Independent lower-right (PR ligands) offsets.
bottom_right_median_label_x_offset=8
bottom_right_median_label_y_offset=22
# Move only the Own-state median label in each lower panel.
# Opposite-state labels continue to use the panel offsets above.
bottom_left_own_median_label_x_offset=8
bottom_left_own_median_label_y_offset=22
bottom_right_own_median_label_x_offset=-80
bottom_right_own_median_label_y_offset=22
